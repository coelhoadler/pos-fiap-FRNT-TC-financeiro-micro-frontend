{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@financeiro/api-client": ["packages/api-client/src"],
      "@financeiro/ui": ["packages/ui/src"]
