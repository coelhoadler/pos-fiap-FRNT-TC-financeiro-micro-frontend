{
  "name": "pos-fiap-frnt-tc-financeiro-micro-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Este é um projeto feito com multi-frontend, cujo objetivo é representar as **transações financeiras** de um usuário.",
  "main": "index.js",
  "scripts": {
    "commit": "git add . && git cz",
    "install": "npm-run-all --serial install:*",
    "install:root-config": "cd apps/root-config && npm install -f",
    "install:transfers": "cd apps/transfers && npm install -f",
    "install:ui": "cd packages/ui && npm install -f",
    "install:dashboard": "cd apps/dashboard && npm install -f",
    "install:login": "cd apps/login && npm install -f",
    "install:api": "cd apps/api && npm install -f",
    "install:api-client": "cd libs/api-client && npm install -f",
    "docker:reset": "docker compose -f docker-compose.dev.yml down --rmi all --volumes --remove-orphans",
    "docker:start": "docker compose -f docker-compose.dev.yml up --build",
    "start": "npm run docker:reset && npm run docker:start",
    "dev": "npm run docker:start",
    "start:libs": "cd apps/libs && npm run build",
    "start:dashboard": "cd apps/dashboard && npm start",
    "start:login": "cd apps/login && npm start",
    "start:micro-api": "cd apps/api && npm run dev",
    "start:root-config": "cd apps/root-config && npm start",
    "start:micro-transfers": "cd apps/transfers && npm start",
    "start:micro-shared-ui": "cd packages/ui && npm start",
    "start:micro-api-client": "cd libs/api-client && npm start",
    "start:micro-dashboard": "cd apps/dashboard && npm start",
    "start:micro-login": "cd apps/login && npm start",
    "start:micro-root-config": "cd apps/root-config && npm start",
    "start:dev": "env-cmd -f environments/.env.development npm-run-all --parallel start:micro-*",
    "start:prod": "docker compose -f docker-compose.prod.yml up",
    "build": "npm-run-all --serial build:*",
    "build:transfers": "cd apps/transfers && npm run build",
    "build:dashboard": "cd apps/dashboard && npm run build",
    "build:login": "cd apps/login && npm run build",
    "build:api": "cd apps/api",
    "build:root-config": "cd apps/root-config && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coelhoadler/pos-fiap-FRNT-TC-financeiro-micro-frontend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/coelhoadler/pos-fiap-FRNT-TC-financeiro-micro-frontend/issues"
  },
  "homepage": "https://github.com/coelhoadler/pos-fiap-FRNT-TC-financeiro-micro-frontend#readme",
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/runtime": "^7.28.4",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "commitizen": "^4.3.1",
    "env-cmd": "^11.0.0",
    "npm-run-all": "^4.1.5",
    "raw-loader": "^4.0.2",
    "rimraf": "^6.0.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "axios": "^1.13.1",
    "dotenv": "^17.2.3",
    "js-cookie": "^3.0.5",
    "mongodb": "^6.17.0",
    "react-currency-input-field": "^3.10.0",
    "react-currency-mask": "^1.3.3",
    "react-hook-form": "^7.60.0",
    "react-lazy-load-image-component": "^1.6.3",
    "react-toastify": "^11.0.5",
    "regenerator-runtime": "^0.14.1",
    "@mui/x-charts": "^8.9.2"
  }
}